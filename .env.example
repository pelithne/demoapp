# Environment Configuration for AI Cat vs Dog Voting App
# Copy this file to .env and fill in your values

# ===================================
# DATABASE CONFIGURATION
# ===================================
POSTGRES_USER=devuser
POSTGRES_PASSWORD=DevPassword123!
POSTGRES_DB=votingapp

# Azure PostgreSQL (for production)
DB_ADMIN_PASSWORD=YourSecurePassword123!

# ===================================
# AZURE CONFIGURATION
# ===================================
# Azure Storage (for image storage)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_CONTAINER_NAME=images

# Azure OpenAI (for image generation)
AZURE_OPENAI_ENDPOINT=https://your-openai-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=dall-e-3

# ===================================
# APPLICATION CONFIGURATION
# ===================================
# API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/votehub
VITE_ENABLE_ANALYTICS=false

# ===================================
# DEVELOPMENT TOOLS
# ===================================
# Redis (for caching)
REDIS_CONNECTION_STRING=localhost:6379

# Application Insights (for monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# ===================================
# SECURITY
# ===================================
# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
JWT_ISSUER=catvdog-voting-app
JWT_AUDIENCE=catvdog-users

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================================
# FEATURE FLAGS
# ===================================
ENABLE_REAL_TIME_UPDATES=true
ENABLE_AI_IMAGE_GENERATION=false
ENABLE_USER_AUTHENTICATION=false
ENABLE_RATE_LIMITING=true

# ===================================
# LOCAL DEVELOPMENT ONLY
# ===================================
# Set to true when using Azurite (Azure Storage Emulator)
USE_STORAGE_EMULATOR=true
STORAGE_EMULATOR_CONNECTION_STRING=UseDevelopmentStorage=true

# Debug settings
DEBUG_LEVEL=Information
ENABLE_DETAILED_ERRORS=true

# Application Configuration  
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/votehub
VITE_ENABLE_ANALYTICS=false

# Azure Configuration (for local development against Azure resources)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=images

# Azure OpenAI Configuration (for AI image generation)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Monitoring
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Optional: Redis for caching
REDIS_CONNECTION_STRING=localhost:6379
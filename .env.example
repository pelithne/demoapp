# Environment variables for local development
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_USER=devuser
POSTGRES_PASSWORD=DevPassword123!
POSTGRES_DB=votingapp

# Admin password for Azure PostgreSQL (used in deployment)
DB_ADMIN_PASSWORD=SecurePassword123!

# Application Configuration  
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/votehub
VITE_ENABLE_ANALYTICS=false

# Azure Configuration (for local development against Azure resources)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=images

# Azure OpenAI Configuration (for AI image generation)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Monitoring
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Optional: Redis for caching
REDIS_CONNECTION_STRING=localhost:6379